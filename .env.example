# Copy to .env for local development (Expo reads EXPO_PUBLIC_* at build time).
EXPO_PUBLIC_API_URL=https://api.orvyn.cash
EXPO_PUBLIC_APP_URL=https://app.orvyn.cash
# The same Privy app as the web (NEXT_PUBLIC_PRIVY_APP_ID), and this app's client id
# (Privy dashboard → App clients). Unset: only the demo and browser-wallet sign-in.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
